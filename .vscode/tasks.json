{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gem: build",
            "type": "shell",
            "command": "gem build theme/jekyll-theme-profile.gemspec",
            "options": {
                "env": {
                    "GEM_VERSION": "0.0.0"
                }
            }
        },
        {
            "label": "gem: push",
            "type": "shell",
            "command": "gem push jekyll-theme-profile-*.gem"
        },
        {
            "label": "bundle: update",
            "type": "shell",
            "command": "bundle update",
            "problemMatcher": []
        },
        {
            "label": "bundle: install",
            "type": "shell",
            "command": "bundle install",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "bin/build.sh",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test: htmlproofer",
            "type": "shell",
            "command": "bin/test.sh",
            "problemMatcher": [],
            "group":"test",
            "dependsOn": ["build"]
        },
        {
            "label": "test: integration",
            "type": "shell",
            "command": "bats tests/*_test.bats",
            "problemMatcher": [],
            "group":"test",
        },
        {
            "label": "test: all",
            "type": "shell",
            "dependsOn": [
                "test: htmlproofer",
                "test: integration",
            ],
            "group": {
                "kind": "test",
                "isDefault": true,
            }
        },
        {
            "label": "serve",
            "type": "shell",
            "command": "bin/serve.sh",
            "problemMatcher": [],
        },
        {
            "label": "serve site",
            "type": "shell",
            "command": "bash bin/local_serve.sh --source site",
            "problemMatcher": [],
        },
        {
            "label": "build site",
            "type": "shell",
            "command": "/usr/bin/time -f \"::STATS:: elapsed=%E cpu=%P max_rss=%MKB\" ./bin/local_build.sh --source site",
            "problemMatcher": [],
        },
        {
            "label": "serve primerpages-gh-pages",
            "type": "shell",
            "command": "bash bin/local_serve.sh --source templates/primerpages-gh-pages",
            "problemMatcher": [],
        },
        {
            "label": "build primerpages-gh-pages",
            "type": "shell",
            "command": "/usr/bin/time -f \"::STATS:: elapsed=%E cpu=%P max_rss=%MKB\" ./bin/local_build.sh --source templates/primerpages-gh-pages",
            "problemMatcher": [],
        },
        {
            "label": "smoke test primerpages-gh-pages",
            "type": "shell",
            "command": "bash bin/template_smoke_test.sh --source templates/primerpages-gh-pages",
            "problemMatcher": [],
            "group":"test",
        },
        {
            "label": "serve primerpages-minimal",
            "type": "shell",
            "command": "bash bin/local_serve.sh --source templates/primerpages-minimal",
            "problemMatcher": [],
        },
        {
            "label": "build primerpages-minimal",
            "type": "shell",
            "command": "/usr/bin/time -f \"::STATS:: elapsed=%E cpu=%P max_rss=%MKB\" ./bin/local_build.sh --source templates/primerpages-minimal",
            "problemMatcher": [],
        },
        {
            "label": "smoke test primerpages-minimal",
            "type": "shell",
            "command": "bin/template_smoke_test.sh --source templates/primerpages-minimal",
            "problemMatcher": [],
            "group":"test",
        },
        {
            "label": "serve primerpages-recommended",
            "type": "shell",
            "command": "bin/local_serve.sh --source templates/primerpages-recommended",
            "problemMatcher": [],
        },
        {
            "label": "build primerpages-recommended",
            "type": "shell",
            "command": "/usr/bin/time -f \"::STATS:: elapsed=%E cpu=%P max_rss=%MKB\" ./bin/local_build.sh --source templates/primerpages-recommended",
            "problemMatcher": [],
        },
        {
            "label": "smoke test primerpages-recommended",
            "type": "shell",
            "command": "bin/template_smoke_test.sh --source templates/primerpages-recommended",
            "problemMatcher": [],
            "group":"test",
        },
        {
            "label": "prepare primerpages-docs",
            "type": "shell",
            "command": "semiliterate build --config templates/primerpages-docs/semiliterate.yml --source templates/primerpages-docs --out templates/primerpages-docs/site --include-mode copy --verbose",
            "problemMatcher": [],
        },
        {
            "label": "serve primerpages-docs",
            "type": "shell",
            "command": "bash bin/local_serve.sh --source templates/primerpages-docs/site",
            "problemMatcher": [],
            "dependsOn": "prepare primerpages-docs",
        },
        {
            "label": "build primerpages-docs",
            "type": "shell",
            "command": "/usr/bin/time -f \"::STATS:: elapsed=%E cpu=%P max_rss=%MKB\" ./bin/local_build.sh --source templates/primerpages-docs/site",
            "problemMatcher": [],
            "dependsOn": "prepare primerpages-docs",
        },
        {
            "label": "smoke test primerpages-docs",
            "type": "shell",
            "command": "bin/template_smoke_test.sh --source templates/primerpages-docs/site",
            "problemMatcher": [],
            "group":"test",
            "dependsOn": "prepare primerpages-docs",
        },
        {
            "label": "release",
            "type": "shell",
            "command": "bin/release.sh theme/jekyll-theme-profile.gemspec",
            "problemMatcher": []
        },
    ]
}
